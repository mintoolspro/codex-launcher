{
  "name": "codex-launcher",
  "version": "0.4.0",
  "description": "Run an isolated Codex Desktop instance with BYOK model providers.",
  "author": "mintoolspro",
  "license": "MIT",
  "main": "electron/main.js",
  "bin": {
    "codex-launcher": "bin/codex-launcher.mjs"
  },
  "scripts": {
    "start": "electron .",
    "cli": "node bin/codex-launcher.mjs",
    "test": "node --test test/*.mjs",
    "check": "find src electron bin test scripts -type f \\( -name '*.js' -o -name '*.mjs' -o -name '*.cjs' \\) -print0 | xargs -0 -n1 node --check",
    "icon": "bash scripts/build-icon.sh",
    "pack": "npm run icon && electron-builder --mac dir zip",
    "release": "node scripts/publish-release.mjs"
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "pro.mintools.codex-launcher",
    "productName": "Codex Launcher",
    "afterPack": "scripts/after-pack.cjs",
    "asar": true,
    "files": [
      "bin/**/*",
      "electron/**/*",
      "src/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        "dir",
        "zip"
      ],
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      }
    }
  },
  "engines": {
    "node": ">=20"
  }
}
